# Dockerfile used by GoReleaser. The binary is cross-compiled by GoReleaser on
# the host and copied in, so no build stage (or QEMU emulation) is needed here.
FROM gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
WORKDIR /app
# dockers_v2 lays the build context out per platform ($TARGETPLATFORM, e.g.
# linux/amd64), so the binary lives under that subdirectory, not at the root.
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/fmlocal /app/fmlocal

EXPOSE 9080 9081
USER nonroot:nonroot
ENTRYPOINT ["/app/fmlocal"]
CMD ["-config", "/etc/fmlocal/config.yaml"]
