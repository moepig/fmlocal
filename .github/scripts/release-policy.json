{
  "project": "fmlocal",
  "assets": [
    "fmlocal_{version}_linux_amd64.tar.gz",
    "fmlocal_{version}_linux_arm64.tar.gz",
    "fmlocal_{version}_darwin_amd64.tar.gz",
    "fmlocal_{version}_darwin_arm64.tar.gz",
    "checksums.txt"
  ],
  "binaries": [
    {
      "asset": "fmlocal_{version}_linux_amd64.tar.gz",
      "id": "fmlocal",
      "os": "linux",
      "arch": "amd64"
    },
    {
      "asset": "fmlocal_{version}_linux_arm64.tar.gz",
      "id": "fmlocal",
      "os": "linux",
      "arch": "arm64"
    },
    {
      "asset": "fmlocal_{version}_darwin_amd64.tar.gz",
      "id": "fmlocal",
      "os": "darwin",
      "arch": "amd64"
    },
    {
      "asset": "fmlocal_{version}_darwin_arm64.tar.gz",
      "id": "fmlocal",
      "os": "darwin",
      "arch": "arm64"
    }
  ],
  "containers": [
    {
      "id": "fmlocal",
      "image": "ghcr.io/moepig/fmlocal",
      "archive": "fmlocal.oci.tar",
      "dockerfile": "Dockerfile.goreleaser"
    }
  ],
  "archive_files": [
    "README*",
    "LICENSE*",
    "CHANGELOG*"
  ]
}
